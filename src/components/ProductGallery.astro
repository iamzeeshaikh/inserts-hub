---
import { Image } from 'astro:assets';
import { asset } from '../lib/images';
import type { Product } from '../lib/site';

interface Props { product: Product }
const { product } = Astro.props;

const shots = product.images.map((src, i) => ({
  image: asset(src),
  alt: product.imageAlts[i] ?? product.name,
}));
---
<div class="gallery" data-gallery>
  <div class="gallery__main">
    {shots.map((shot, i) => (
      <Image
        src={shot.image}
        alt={shot.alt}
        width={600}
        height={600}
        densities={[1, 2]}
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : undefined}
        decoding={i === 0 ? 'sync' : 'async'}
        hidden={i !== 0}
        data-gallery-slide={i}
      />
    ))}
  </div>

  {shots.length > 1 && (
    <ul class="gallery__thumbs" role="list">
      {shots.map((shot, i) => (
        <li>
          <button
            type="button"
            data-gallery-thumb={i}
            aria-current={i === 0 ? 'true' : 'false'}
          >
            <Image
              src={shot.image}
              alt={`Show image ${i + 1} of ${shots.length}: ${shot.alt}`}
              width={140}
              height={140}
              densities={[1, 2]}
              loading="lazy"
              decoding="async"
            />
          </button>
        </li>
      ))}
    </ul>
  )}
</div>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const slides = gallery.querySelectorAll<HTMLImageElement>('img[data-gallery-slide]');
    const thumbs = gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]');

    // Hidden slides carry loading="lazy" and never intersect, so without a
    // nudge the first click on a thumbnail would wait on a network fetch.
    // Warm each slide off the critical path so the swap is instant.
    const warm = (img: HTMLImageElement | undefined) => {
      if (!img || img.dataset.warmed) return;
      img.dataset.warmed = 'true';
      const pre = new Image();
      pre.fetchPriority = 'low';
      pre.decoding = 'async';
      if (img.sizes) pre.sizes = img.sizes;
      if (img.srcset) pre.srcset = img.srcset;
      pre.src = img.src;
      img.loading = 'eager';
    };

    const warmAll = () => slides.forEach((slide) => warm(slide));
    const idle: (fn: () => void) => void =
      'requestIdleCallback' in window
        ? (fn) => window.requestIdleCallback(fn)
        : (fn) => setTimeout(fn, 300);
    if (document.readyState === 'complete') idle(warmAll);
    else window.addEventListener('load', () => idle(warmAll), { once: true });

    thumbs.forEach((thumb, index) => {
      thumb.addEventListener('pointerenter', () => warm(slides[index]), { passive: true });
      thumb.addEventListener('touchstart', () => warm(slides[index]), { passive: true });
      thumb.addEventListener('click', () => {
        warm(slides[index]);
        slides.forEach((slide, i) => slide.toggleAttribute('hidden', i !== index));
        thumbs.forEach((t, i) => t.setAttribute('aria-current', String(i === index)));
      });
    });
  }
</script>
