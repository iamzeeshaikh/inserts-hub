---
import { Image } from 'astro:assets';
import { asset } from '../lib/images';
import type { Product } from '../lib/site';

interface Props {
  product: Product;
  eager?: boolean;
  /** Depends on whether the surrounding section already has its own heading. */
  headingLevel?: 2 | 3;
}
const { product, eager = false, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const img = asset(product.images[0]);
---
<article class="card">
  <a class="card__media" href={product.url} tabindex="-1" aria-hidden="true">
    <Image
      src={img}
      alt=""
      width={400}
      height={400}
      densities={[1, 2]}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
    />
  </a>
  <div class="card__body">
    <Heading class="card__title"><a href={product.url}>{product.name}</a></Heading>
  </div>
</article>
