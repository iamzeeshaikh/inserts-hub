---
import type { GetStaticPaths } from 'astro';
import ProductArchive from '../../../components/ProductArchive.astro';
import { alphabetical, site } from '../../../lib/site';

/** Pages 2..N of the products archive, at the same URLs WooCommerce served. */
export const getStaticPaths: GetStaticPaths = () => {
  const last = Math.ceil(alphabetical.length / site.perPage);
  return Array.from({ length: Math.max(0, last - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { page: i + 2 },
  }));
};

const { page } = Astro.props as { page: number };
---
<ProductArchive
  heading="Products"
  title={`Products - Page ${page} - Inserts Hub`}
  description={`Page ${page} of custom packaging inserts from Inserts Hub, including cardboard, corrugated, foam and kraft insert styles.`}
  base="/products/"
  page={page}
  all={alphabetical}
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Products' }]}
/>
