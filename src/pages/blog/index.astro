---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { BLOG_POSTS } from '../../lib/blog';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Blog' },
];

const fmt = (iso: string) =>
  new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
---
<BaseLayout
  title="Blog | Inserts Hub"
  description="Guides on molded pulp, foam, divider and corrugated inserts, from cavity design to transit testing for packaging buyers."
  path="/blog/"
>
  <Breadcrumbs items={crumbs} />

  <section class="wrap blog-wrap">
    <h1>Packaging Inserts Blog</h1>
    <p class="blog-lead">
      Practical guides on insert materials, divider design, food-grade cavities and transit protection.
    </p>
    <div class="blog-grid">
      {
        BLOG_POSTS.map((post, i) => (
          <article class="blog-card">
            <a href={post.url}>
              <img
                src={post.image}
                alt={post.imageAlt}
                width={post.imageWidth}
                height={post.imageHeight}
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </a>
            <div class="blog-card-body">
              <p class="blog-date">{fmt(post.date)}</p>
              <h2><a href={post.url}>{post.title}</a></h2>
              <p class="blog-excerpt">{post.metaDescription}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .blog-wrap { max-width: 1100px; margin: 0 auto; padding: 32px 16px 56px; }
  .blog-lead { color: #666; max-width: 640px; margin: 8px 0 28px; }
  .blog-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 26px; }
  .blog-card { border: 1px solid #e3ded6; border-radius: 10px; overflow: hidden; background: #fff; }
  .blog-card img { display: block; width: 100%; height: auto; }
  .blog-card-body { padding: 16px 18px 20px; }
  .blog-date { font-size: .8rem; color: #8a7a63; margin: 0 0 6px; }
  .blog-card-body h2 { font-size: 1.08rem; line-height: 1.35; margin: 0 0 8px; }
  .blog-card-body h2 a { color: inherit; text-decoration: none; }
  .blog-card-body h2 a:hover { text-decoration: underline; }
  .blog-excerpt { font-size: .9rem; color: #666; margin: 0; }
</style>
