---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import InquiryForm from '../components/InquiryForm.astro';
import CTASection from '../components/CTASection.astro';
import { site, homeProducts } from '../lib/site';
import { organization, website, collectionPage } from '../lib/schema';

/**
 * Section order matches the live page and the PDF capture exactly: four feature
 * cards straight under the navigation, the blue range button, then the product
 * grid with the enquiry form beside it, then the quote CTA.
 *
 * The live page renders no <h1> at all. Rather than invent a headline or
 * restructure the layout to fit one, the required single <h1> is visually
 * hidden and carries the page's own subject — see MIGRATION_CONFLICTS.md.
 */
---
<BaseLayout
  title="Custom Inserts | Foam, Cardboard & More - Inserts Hub"
  description="Shop wholesale custom inserts for all your packaging needs at Inserts Hub. From foam inserts and cardboard dividers, we deal in all."
  path="/"
  schema={[organization(), website(), collectionPage('/', 'Inserts Hub', 'Custom packaging inserts at wholesale prices.', homeProducts)]}
>
  <!-- First feature card is the LCP element; fetch it alongside the stylesheet. -->
  <link
    rel="preload"
    as="image"
    href={site.homeFeatures[0].image.replace(/\.gif$/, '.webp')}
    type="image/webp"
    slot="head"
  />
  <h1 class="visually-hidden">Custom packaging inserts at wholesale prices</h1>

  <div class="wrap">
    <ul class="features" role="list">
      {site.homeFeatures.map((f, i) => (
        <li class={f.tint ? 'feature feature--tint' : 'feature'}>
          <picture>
            <source srcset={f.image.replace(/\.gif$/, '.webp')} type="image/webp" />
            <img
              src={f.image}
              alt=""
              width="190"
              height="143"
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding={i < 2 ? 'sync' : 'async'}
            />
          </picture>
          <h2>{f.title}</h2>
        </li>
      ))}
    </ul>
  </div>

  <div class="wrap">
    <p class="home-cta">
      <a class="btn btn--blue" href="/products/">Explore Our Range of Custom Inserts and Packaging Solutions</a>
    </p>

    <div class="home-body">
      <ProductGrid products={homeProducts} eagerCount={3} />
      <aside class="home-aside" aria-labelledby="home-enquiry-heading">
        <div class="aside-form">
          <h2 id="home-enquiry-heading" class="visually-hidden">Request a quote</h2>
          <InquiryForm variant="aside" id="home-aside" />
        </div>
      </aside>
    </div>
  </div>

  <CTASection />
</BaseLayout>
