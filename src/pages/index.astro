---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/HeroSlider.astro';
import ProductGrid from '../components/ProductGrid.astro';
import InquiryForm from '../components/InquiryForm.astro';
import CTASection from '../components/CTASection.astro';
import { site, homeProducts } from '../lib/site';
import { organization, website, collectionPage } from '../lib/schema';

/**
 * Section order: hero slider (built from the supplied Elementor slide
 * templates), the four feature cards, the blue range button, the product grid
 * with the enquiry form beside it, then the quote CTA.
 *
 * Slide 1 carries the page's single <h1>.
 */
---
<BaseLayout
  title="Custom Inserts | Foam, Cardboard & More - Inserts Hub"
  description="Shop wholesale custom inserts for all your packaging needs at Inserts Hub. From foam inserts and cardboard dividers, we deal in all."
  path="/"
  schema={[organization(), website(), collectionPage('/', 'Inserts Hub', 'Custom packaging inserts at wholesale prices.', homeProducts)]}
>
  <HeroSlider />

  <div class="wrap">
    <ul class="features" role="list">
      {site.homeFeatures.map((f, i) => (
        <li class={f.tint ? 'feature feature--tint' : 'feature'}>
          <picture>
            <source srcset={f.image.replace(/\.gif$/, '.webp')} type="image/webp" />
            <img
              src={f.image}
              alt=""
              width="190"
              height="143"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <h2>{f.title}</h2>
        </li>
      ))}
    </ul>
  </div>

  <div class="wrap">
    <p class="home-cta">
      <a class="btn btn--blue" href="/products/">Explore Our Range of Custom Inserts and Packaging Solutions</a>
    </p>

    <div class="home-body">
      <ProductGrid products={homeProducts} eagerCount={0} />
      <aside class="home-aside" aria-labelledby="home-enquiry-heading">
        <div class="aside-form">
          <h2 id="home-enquiry-heading" class="visually-hidden">Request a quote</h2>
          <InquiryForm variant="aside" id="home-aside" />
        </div>
      </aside>
    </div>
  </div>

  <CTASection />
</BaseLayout>
