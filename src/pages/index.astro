---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import InquiryForm from '../components/InquiryForm.astro';
import CTASection from '../components/CTASection.astro';
import { site, homeProducts } from '../lib/site';
import { asset } from '../lib/images';
import { organization, website, collectionPage } from '../lib/schema';

const slides = site.slides.map((s) => ({ ...s, asset: asset(s.image) }));
---
<BaseLayout
  title="Custom Inserts | Foam, Cardboard & More - Inserts Hub"
  description="Shop wholesale custom inserts for all your packaging needs at Inserts Hub. From foam inserts and cardboard dividers, we deal in all."
  path="/"
  schema={[organization(), website(), collectionPage('/', 'Inserts Hub', 'Custom packaging inserts at wholesale prices.', homeProducts)]}
>
  <section class="hero" aria-label="Featured">
    <div class="wrap">
      {slides.map((slide, i) => (
        <div class="hero__slide" hidden={i !== 0} data-slide={i}>
          <div class="hero__copy">
            {slide.h1
              ? <h1>{slide.heading}</h1>
              : <h2>{slide.heading}</h2>}
            <p>{slide.text}</p>
            <a class="btn btn--red" href={slide.cta.href}>{slide.cta.label}</a>
          </div>
          <div class="hero__media">
            <Image
              src={slide.asset}
              alt={slide.heading}
              width={520}
              height={520}
              densities={[1, 2]}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              decoding={i === 0 ? 'sync' : 'async'}
            />
          </div>
        </div>
      ))}
    </div>
    <div class="hero__dots" role="tablist" aria-label="Choose a featured slide">
      {slides.map((slide, i) => (
        <button
          type="button"
          role="tab"
          data-dot={i}
          aria-current={i === 0 ? 'true' : 'false'}
          aria-label={slide.heading}
        ></button>
      ))}
    </div>
  </section>

  <div class="wrap">
    <ul class="features" role="list">
      {site.homeFeatures.map((f) => (
        <li class={f.tint ? 'feature feature--tint' : 'feature'}>
          <img src={f.image} alt="" width="190" height="143" loading="lazy" decoding="async" />
          <h2>{f.title}</h2>
        </li>
      ))}
    </ul>
  </div>

  <div class="wrap">
    <p class="home-cta">
      <a class="btn btn--blue" href="/products/">Explore Our Range of Custom Inserts and Packaging Solutions</a>
    </p>

    <div class="home-body">
      <div>
        <h2 class="visually-hidden">Our custom packaging inserts</h2>
        <ProductGrid products={homeProducts} eagerCount={3} headingLevel={3} />
      </div>
      <aside class="home-aside" aria-labelledby="home-enquiry-heading">
        <div class="aside-form">
          <h2 id="home-enquiry-heading">Request a quote</h2>
          <InquiryForm variant="aside" id="home-aside" />
        </div>
      </aside>
    </div>
  </div>

  <CTASection />
</BaseLayout>

<script>
  const slides = document.querySelectorAll<HTMLElement>('[data-slide]');
  const dots = document.querySelectorAll<HTMLButtonElement>('[data-dot]');
  dots.forEach((dot, index) => {
    dot.addEventListener('click', () => {
      slides.forEach((slide, i) => slide.toggleAttribute('hidden', i !== index));
      dots.forEach((d, i) => d.setAttribute('aria-current', String(i === index)));
    });
  });
</script>
