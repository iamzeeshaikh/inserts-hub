---
/**
 * Every /category/* URL on the old site was a spam doorway archive injected by
 * the malware — the site has never published a blog post. They return a real
 * 410 Gone so search engines drop them, and they are absent from the sitemap.
 *
 * Anything under /category/ that we have not explicitly verified as spam falls
 * through to a normal 404 instead.
 */
import { GONE_CATEGORY_SLUGS } from '../../lib/redirects.mjs';

export const prerender = false;

const raw = (Astro.params.slug ?? '').replace(/^\/+|\/+$/g, '').toLowerCase();
const isKnownSpam = GONE_CATEGORY_SLUGS.includes(raw) || GONE_CATEGORY_SLUGS.includes(raw.split('/')[0]);

const body = `<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="robots" content="noindex,nofollow">
<title>410 Gone - Inserts Hub</title></head>
<body><h1>410 Gone</h1>
<p>This URL was created by a security incident and has been permanently removed.</p>
<p><a href="https://insertshub.com/">Go to the Inserts Hub homepage</a></p>
</body></html>`;

return new Response(isKnownSpam ? body : null, {
  status: isKnownSpam ? 410 : 404,
  headers: {
    'content-type': 'text/html; charset=utf-8',
    'x-robots-tag': 'noindex, nofollow',
    'cache-control': 'public, max-age=0, s-maxage=86400',
  },
});
---
