---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RichText from '../components/RichText.astro';
import CTASection from '../components/CTASection.astro';
import { Image } from 'astro:assets';
import { pages, type Page } from '../lib/site';
import { asset } from '../lib/images';
import { breadcrumbs, contactPage } from '../lib/schema';

/**
 * The static WordPress pages, at their original slugs. `/refund_returns/` keeps
 * its underscore because that is the indexed URL.
 */
export const getStaticPaths: GetStaticPaths = () =>
  pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));

const { page } = Astro.props as { page: Page };

const crumbs = [{ label: 'Home', href: '/' }, { label: page.h1 }];
// The live thank-you page pairs its heading with a green tick.
const confirmation = page.slug === 'thank-you' ? asset('/images/site/check-mark-green.jpg') : null;
const schema: unknown[] = [breadcrumbs(crumbs)];
// Organization comes from SEOHead on every route.
if (page.slug === 'contact-us') schema.push(contactPage(page.url, page.title));
---
<BaseLayout
  title={page.title}
  description={page.description}
  path={page.url}
  ogType="article"
  noindex={page.noindex}
  schema={schema}
>
  <Breadcrumbs items={crumbs} />

  <div class="wrap page-body">
    <h1>{page.h1}</h1>
    {confirmation && (
      <p class="confirmation">
        <Image
          src={confirmation}
          alt="Your message has been sent"
          width={220}
          height={220}
          densities={[1, 2]}
          loading="eager"
        />
      </p>
    )}
    {page.slug === 'thank-you' && (
      <p>Thanks for getting in touch. Our team has your enquiry and will reply shortly.
        In the meantime you can <a href="/products/">browse the full range of inserts</a>.</p>
    )}
    {page.bodyHtml && <RichText html={page.bodyHtml} />}
  </div>

  <CTASection />
</BaseLayout>
